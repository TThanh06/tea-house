{
  "name": "tea-house",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:seed": "node --env-file-if-exists=.env server/seed.js",
    "db:setup": "node scripts/setup-mysql.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-db.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.mjs",
    "test": "node --test tests/*.test.js",
    "verify": "npm run test && npm run build && node scripts/check-release.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "mysql2": "3.24.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2"
  }
}
